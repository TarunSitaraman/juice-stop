# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules
.pnp
.pnp.js

# ─── Build outputs ────────────────────────────────────────────────────────────
.next
dist
build
out
*.tsbuildinfo

# ─── Environment variables ────────────────────────────────────────────────────
# Never commit real env files. .env.example files ARE committed (they're safe templates).
.env
.env.local
.env.development
.env.production
.env.*.local
apps/web/.env.local
packages/api/.env
packages/db/.env

# ─── Turbo ────────────────────────────────────────────────────────────────────
.turbo

# ─── Prisma ───────────────────────────────────────────────────────────────────
# DO NOT ignore prisma/migrations/ — those SQL files must be committed
# so `prisma migrate deploy` works on Railway and any fresh environment.
# Only ignore the generated client (it's rebuilt via `prisma generate` on install).
packages/db/node_modules

# ─── Expo / React Native ──────────────────────────────────────────────────────
apps/mobile/.expo
apps/mobile/dist
apps/mobile/android
apps/mobile/ios
*.jks
*.keystore

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea
*.swp
*.swo

